# ===================================
# 🚀 CAR BOOKING APP - BACKEND CONFIG
# ===================================
# Copy this file to .env and fill in your values
# NEVER commit .env files to git!

# ========== SERVER CONFIGURATION ==========
PORT=5000
NODE_ENV=development
# Production: NODE_ENV=production

# ========== DATABASE ==========
MONGODB_URI=mongodb://localhost:27017/carbooking
# Production MongoDB Atlas:
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/carbooking?retryWrites=true&w=majority

# ========== AUTH - JWT TOKENS ==========
# Generate secure keys: openssl rand -base64 32
JWT_SECRET=your-jwt-secret-min-32-characters-long-change-this
JWT_REFRESH_SECRET=your-jwt-refresh-secret-min-32-characters-long-change-this
JWT_EXPIRE=7d
JWT_REFRESH_EXPIRE=30d

# ========== CORS & SECURITY ==========
CORS_ORIGIN=http://localhost:3000
# Production: CORS_ORIGIN=https://yourdomain.com
CORS_CREDENTIALS=true

# ========== FILE UPLOAD ==========
FILE_UPLOAD_PATH=/uploads
MAX_FILE_SIZE=5242880
# 5MB in bytes (5 * 1024 * 1024)

# ========== EMAIL CONFIGURATION ==========
# Using SendGrid
EMAIL_SERVICE=sendgrid
SENDGRID_API_KEY=SG.your-sendgrid-api-key-here
EMAIL_FROM=noreply@carbooking.com
EMAIL_FROM_NAME=Car Booking App

# Alternative: Using SMTP (Mailtrap for dev, Gmail or custom for prod)
# EMAIL_SERVICE=smtp
# SMTP_HOST=sandbox.smtp.mailtrap.io
# SMTP_PORT=2525
# SMTP_USER=your-mailtrap-user
# SMTP_PASSWORD=your-mailtrap-password

# ========== STRIPE PAYMENT ==========
STRIPE_PUBLIC_KEY=pk_live_your-public-key-here
STRIPE_SECRET_KEY=sk_live_your-secret-key-here
# Dev keys start with pk_test_ and sk_test_
# Production keys start with pk_live_ and sk_live_

# ========== WEBHOOK SECRETS ==========
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret-here

# ========== LOGGING ==========
LOG_LEVEL=debug
# For production: LOG_LEVEL=error or LOG_LEVEL=warn
LOG_FILE=logs/app.log

# ========== SESSION ==========
SESSION_SECRET=your-session-secret-change-this

# ========== REDIS (Optional - for caching/queue) ==========
# REDIS_URL=redis://localhost:6379
# REDIS_PASSWORD=your-redis-password

# ========== SOCIAL LOGIN (Optional) ==========
# GOOGLE_CLIENT_ID=your-google-client-id
# GOOGLE_CLIENT_SECRET=your-google-client-secret
# FACEBOOK_APP_ID=your-facebook-app-id
# FACEBOOK_APP_SECRET=your-facebook-app-secret

# ========== ADMIN CREDENTIALS (Seed data) ==========
ADMIN_EMAIL=admin@carbooking.com
ADMIN_PASSWORD=Admin@123456

# ========== PAYMENT SETTINGS ==========
CURRENCY=USD
TAX_RATE=0.08
# 8% tax rate

# ========== PAGINATION ==========
DEFAULT_PAGE_LIMIT=20
MAX_PAGE_LIMIT=100

# ========== RATE LIMITING ==========
RATE_LIMIT_WINDOW_MS=900000
# 15 minutes in milliseconds
RATE_LIMIT_MAX_REQUESTS=100
# Max requests per window

# ========== NOTIFICATIONS (Optional) ==========
# SMS using Twilio
# TWILIO_ACCOUNT_SID=your-account-sid
# TWILIO_AUTH_TOKEN=your-auth-token
# TWILIO_PHONE_NUMBER=+1234567890

# Firebase for push notifications
# FIREBASE_PROJECT_ID=your-project-id
# FIREBASE_PRIVATE_KEY=your-private-key
# FIREBASE_CLIENT_EMAIL=your-client-email
