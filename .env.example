# ====================================
# 🔧 CAR BOOKING APP - ADMIN CONFIG
# ====================================
# Copy this file to .env.local and fill in your values
# React uses .env.local for frontend environment variables

# ========== API CONFIGURATION ==========
REACT_APP_API_BASE_URL=http://localhost:5000/api
# Production: REACT_APP_API_BASE_URL=https://api.yourdomain.com/api

# ========== STRIPE PUBLIC KEY ==========
REACT_APP_STRIPE_PUBLIC_KEY=pk_test_your-public-key-here
# Development: pk_test_...
# Production: pk_live_...

# ========== APP INFO ==========
REACT_APP_APP_NAME=Car Booking Admin
REACT_APP_VERSION=1.0.0

# ========== GOOGLE ANALYTICS ==========
REACT_APP_GA_ID=G-your-google-analytics-id-admin

# ========== SENTRY (Error Tracking) ==========
REACT_APP_SENTRY_DSN=https://your-sentry-dsn@sentry.io/admin-project-id

# ========== DEBUG MODE ==========
REACT_APP_DEBUG=false
# Set to true to enable detailed console logs in development

# ========== ADMIN SETTINGS ==========
REACT_APP_ADMIN_MODE=true
REACT_APP_ALLOW_CSV_EXPORT=true
