# ====================================
# 🎨 CAR BOOKING APP - CLIENT CONFIG
# ====================================
# Copy this file to .env.local and fill in your values
# React uses .env.local for client environment variables

# ========== API CONFIGURATION ==========
REACT_APP_API_BASE_URL=http://localhost:5000/api
# Production: REACT_APP_API_BASE_URL=https://api.yourdomain.com/api

# ========== STRIPE PUBLIC KEY ==========
REACT_APP_STRIPE_PUBLIC_KEY=pk_test_your-public-key-here
# Development: pk_test_...
# Production: pk_live_...

# ========== APP INFO ==========
REACT_APP_APP_NAME=Car Booking App
REACT_APP_VERSION=1.0.0

# ========== GOOGLE ANALYTICS ==========
REACT_APP_GA_ID=G-your-google-analytics-id

# ========== SENTRY (Error Tracking) ==========
REACT_APP_SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# ========== DISABLE AUTOMATIC BATCHING (if needed) ==========
# REACT_APP_DISABLE_AUTO_BATCHING=false

# ========== DEBUG MODE ==========
REACT_APP_DEBUG=false
# Set to true to enable detailed console logs in development
